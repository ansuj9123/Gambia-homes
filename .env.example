DATABASE_URL="file:./dev.db"

# Auth.js. Generate your own: npx auth secret  (or any 32+ random bytes, base64)
AUTH_SECRET="replace-with-a-long-random-string"

# Local admin account created by `npm run db:seed`. Development only: change before deploying.
ADMIN_EMAIL="admin@gambiahomes.test"
ADMIN_PASSWORD="change-me-dev-only"

# Optional social sign-in. Leave empty to hide the buttons.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Stripe (card payments). Use TEST keys locally: sk_test_... from https://dashboard.stripe.com/test/apikeys
# Leave empty to switch payments off (orders then wait for a payment link).
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=""

# Public address of the site, used for payment return links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (any SMTP provider). Leave empty to only record emails in Admin → Messages sent.
# e.g. SMTP_URL="smtps://resend:YOUR_API_KEY@smtp.resend.com:465"
SMTP_URL=""
EMAIL_FROM="Gambia Homes <hello@yourdomain.com>"

# Where uploaded photos are stored (local disk in development).
STORAGE_DIR="storage"

# Phone testing on your Wi-Fi (npm run dev:lan): your computer's Wi-Fi address
DEV_ORIGINS=""
