    "nodemailer": "6.10.1",
    "pdf-lib": "1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "sharp": "0.34.5",
    "stripe": "22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.1.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/nodemailer": "6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.16.2",
    "tailwindcss": "4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5"
